generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id          Int      @id @default(autoincrement())
  company     String
  role        String
  status      String   @default("Applied") // Applied, OA, Interview, Offer, Rejected
  dateApplied DateTime @default(now())
  link        String?
  notes       String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}